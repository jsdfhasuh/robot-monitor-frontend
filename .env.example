# 本地开发时是否使用 mock 数据。false 表示走真实后端。
VITE_USE_MOCK=true

# axios baseURL，生产环境建议保持 /api，走前端 Nginx 代理。
VITE_API_BASE_URL=/api

# 本地 npm run dev 时代理到后端地址
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_BACKEND_WS=ws://127.0.0.1:8000

# 浏览器访问后端公共前缀。生产默认留空，走前端 Nginx 的 /api 反代。
VITE_BACKEND_PUBLIC_BASE=

# 后端当前 ROI 是像素矩形，前端 polygon 保存时会按这个尺寸换算外接矩形。
VITE_DEFAULT_FRAME_WIDTH=1280
VITE_DEFAULT_FRAME_HEIGHT=720

# 当前默认视频流使用后端 API 下的 MJPEG。
VITE_DEFAULT_STREAM_TYPE=mjpeg

# 前端浏览器侧日志
VITE_FRONTEND_LOG_MAX=500
VITE_FRONTEND_LOG_CONSOLE=true
VITE_API_TIMEOUT=15000
